node_modules/
*.log
.DS_Store

# Local Codex linked worktrees — never stage nested repositories as gitlinks
/.codex/worktrees/

# Secrets — never commit
.netlify-token

# Local backup archives
_old_*.zip

# Build output (regenerated from chart-quest.html by build.js) — not source
chart-quest.min.html

# Large deploy/build artifacts — NEVER track (deploy.zip was 131MB in-tree)
deploy.zip
*.tmp

# Large video ORIGINALS — keep locally, ship only the compressed clips
_video-originals/
lesson-visual-audit.html   # generated by scripts/lesson_visual_harness.py (dev artifact)

# Python bytecode
__pycache__/
*.pyc

# Beta QA snapshot — regenerated by scripts/beta_pull.py, not source. It is a dated dump of
# live tester telemetry (including survey free text), so it would churn on every pull and
# rot in history. beta-qa.html renders an empty state telling you exactly how to refresh it.
beta-qa/beta-data.json

# Generated by `node beta-qa/parity.js --make-fixture` / --self-test.
beta-qa/parity-fixture.json

# Local data backups — snapshots of live tester telemetry, not source.
backups/
